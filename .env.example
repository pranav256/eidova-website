# Public build-time settings. Do not put secrets in VITE_* values.
# Candidate 0.2.0 needs an API with /mcp/core; upgrade the API before the website.
VITE_MCP_URL=https://open-design-mcp-liard.vercel.app/mcp
VITE_CATALOG_URL=/api/catalog
VITE_REGISTRY_ORIGIN=https://open-design-mcp-liard.vercel.app
VITE_REPOSITORY_URL=https://github.com/pranav256/eidova-website
VITE_MCP_REPOSITORY_URL=https://github.com/pranav256/eidova-mcp

# Development proxy target. Set to http://localhost:3000 for a local MCP service.
MCP_PROXY_ORIGIN=https://open-design-mcp-liard.vercel.app

# Own persistent Studio backend. Never put workspace or model keys here.
# Required for production Team workspace; omit to show its setup state.
# VITE_STUDIO_API_URL=https://studio.example.com
# Development proxy (the production backend must allow the website's exact origin).
STUDIO_PROXY_ORIGIN=http://127.0.0.1:3210
