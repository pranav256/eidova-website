{
  "version": 1,
  "product": "Open Design website",
  "features": [
    {
      "id": "website",
      "name": "Website",
      "description": "Public design-system catalog and agent connection guide",
      "flows": [
        {
          "id": "try-a-theme",
          "name": "Try a theme",
          "steps": [
            {
              "name": "Apply a theme to the entire site",
              "screen": "/?theme=<theme-id>&mode=<appearance>",
              "components": [
                "src/App.tsx",
                "src/theme.ts",
                "src/catalog-themes.json"
              ],
              "data": [
                "31 bundled theme palettes in light and dark",
                "Saved theme and mode in localStorage and URL",
                "Search, filters, scroll, focus and setup state retained"
              ]
            },
            {
              "name": "Switch appearance or reset theme",
              "screen": "Sticky site theme controls",
              "components": [
                "src/App.tsx",
                "src/theme.ts"
              ],
              "data": [
                "Light/dark applies to the selected theme",
                "Reset restores Open Design while retaining appearance"
              ]
            }
          ]
        },
        {
          "id": "browse-the-catalog",
          "name": "Browse the catalog",
          "steps": [
            {
              "name": "Search and filter themes",
              "screen": "Themes section",
              "components": [
                "src/App.tsx"
              ],
              "data": [
                "GET /api/catalog"
              ]
            },
            {
              "name": "Inspect theme tokens",
              "action": "Open registry JSON",
              "components": [],
              "data": [
                "GET /registry/:theme/globals.json"
              ]
            }
          ]
        },
        {
          "id": "connect-an-agent",
          "name": "Connect an agent",
          "steps": [
            {
              "name": "Choose client setup",
              "screen": "Connection section",
              "components": [
                "src/App.tsx"
              ],
              "data": []
            },
            {
              "name": "Copy URL or command",
              "action": "Clipboard",
              "components": [],
              "data": []
            }
          ]
        }
      ],
      "components": []
    }
  ]
}
