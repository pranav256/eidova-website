{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/studio/", "destination": "/index.html" },
    { "source": "/api/catalog", "destination": "https://open-design-mcp-liard.vercel.app/api/catalog" },
    { "source": "/api/resources/:path*", "destination": "https://open-design-mcp-liard.vercel.app/api/resources/:path*" },
    { "source": "/api/design-systems/:id/design.md", "destination": "https://open-design-mcp-liard.vercel.app/api/design-systems/:id/design.md" },
    { "source": "/registry/:path*", "destination": "https://open-design-mcp-liard.vercel.app/registry/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
